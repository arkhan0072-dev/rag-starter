# Copy to .env and adjust.

DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Local models (downloaded on first use, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Answer generation: none | anthropic | openai
# "none" returns the best matching passage, so the API works without any key.
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
